{
  "name": "Kikas e Bonitas API",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [5000, 3306],
  "portsAttributes": {
    "5000": { "label": "Kikas e Bonitas API", "onAutoForward": "openBrowser" },
    "3306": { "label": "MySQL" }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y mysql-client && dotnet tool install --global dotnet-ef",
  "containerEnv": {
    "PATH": "/home/vscode/.dotnet/tools:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "eamodio.gitlens",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
